# Copy to backend/.env for local development; replace all placeholders.
DB_URL=jdbc:mysql://localhost:3306/travel_planner?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=travel_planner_app
DB_PASSWORD=REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_OUTPUT_FROM_openssl_rand_base64_32
JWT_ISSUER=travel-planner-api
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Travel Planner Admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_12_CHARACTER_OR_LONGER_PASSWORD
